; Two retail scene depth palettes. R0=scene 0/1 for the binder.
; Call shade setup after binding, then use the depth-colour entry for tag 62.
; These tables live in this ROM bank; the generic material entry still
; expects bank 3 depth data. R0=material index 0..135 for depth-colour lookup.
; R11=return; lookup restores ROMBR to the shape bank, like material setup.
mrdepth_begin
mretail_binddepth
	with r0
	from r0
	beq rdepth_zero
	nop
	iwt r0,#retail_depthscene1&WM
	bra rdepth_bind
	nop
rdepth_zero
	iwt r0,#retail_depthscene0&WM
rdepth_bind
	sms [m_depthstab],r0
	jmp r11
	nop
mretail_depthcolour
	ibt r1,#retail_depthscene0>>16
	from r1
	romb
	lms r3,[m_depthsptr]
	to r14
	add r3
	getc
	lms r0,[m_shapebank]
	romb
	with r2
	to r14
	jmp r11
	nop
retail_depthscene0
